{
    "name": "starknet-devnet",
    "version": "0.10.0",
    "description": "Starknet Devnet provider",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build-check": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
        "test": "mocha",
        "pretest": "npm run build",
        "format": "prettier --log-level log --write \"**/*.{ts,js,md,yml,json}\"",
        "format-check": "prettier --log-level log --check \"**/*.{ts,js,md,yml,json}\"",
        "lint": "oxlint --fix",
        "lint-check": "oxlint --deny-warnings",
        "check-all-tests-executed": "! grep '\\(describe\\|it\\)\\.only(' $(git ls-files '*.ts')"
    },
    "author": "SpaceShard",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/starknet-io/starknet-devnet-js.git"
    },
    "keywords": [
        "starknet",
        "devnet",
        "provider",
        "starkware",
        "l2",
        "l1-l2",
        "zk",
        "json-rpc"
    ],
    "license": "MIT",
    "dependencies": {
        "axios": "^1.20.0"
    },
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.19.2",
        "@types/tmp": "^0.2.6",
        "chai": "^6.3.0",
        "ethers": "^6.17.0",
        "mocha": "^12.0.3",
        "oxlint": "~1.88.0",
        "prettier": "^3.9.10",
        "starknet": "~10.8.0",
        "tmp": "^0.2.3",
        "tsx": "^4.23.15",
        "typescript": "~7.0.2"
    }
}
